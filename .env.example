# Supabase project that stores the data.
# Project settings -> Data API -> Project URL and the publishable (anon) key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Whoever signs in with this address owns every folder and project.
# Keep it in step with the `admins` table in the database.
VITE_ADMIN_EMAIL=you@example.com
